{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2-schema.org/profiles/signature/v0.0.4/schema.json",
  "title": "Signature Profile v0.0.4",
  "version": "0.0.4",
  "description": "Profile selecting signature-related defs (JWS/JAdES, handwritten, biometric) and the JWE encryption defs (RFC 7516) from Grand Vault v0.0.14. NO own def bodies — pure $ref aggregator. v0.0.4 = v0.0.3 + JWEFlattenedJSON / JWEProtectedHeaderDecoded / JWEKeyManagementAlgEnum / JWEContentEncryptionAlgEnum.",
  "license": "Apache-2.0",
  "x-a2-role": "profile",
  "x-a2-base-schema": "https://a2-schema.org/vault/v0.0.14/schema.json",
  "$defs": {
    "SignatureNode": {
      "oneOf": [
        {
          "$ref": "https://a2-schema.org/vault/v0.0.14/schema.json#/$defs/BlockSignature"
        },
        {
          "$ref": "https://a2-schema.org/vault/v0.0.14/schema.json#/$defs/HandwrittenSignature"
        },
        {
          "$ref": "https://a2-schema.org/vault/v0.0.14/schema.json#/$defs/BiometricCapture"
        },
        {
          "$ref": "https://a2-schema.org/vault/v0.0.14/schema.json#/$defs/SignatureBundle"
        }
      ]
    },
    "JWEFlattenedJSON": {
      "$ref": "https://a2-schema.org/vault/v0.0.14/schema.json#/$defs/JWEFlattenedJSON"
    }
  },
  "x-a2-included-defs": [
    "MLDSAAlgorithmEnum",
    "SignatureAlgorithmType",
    "LegacySignatureAlgEnum",
    "JAdESProfileEnum",
    "JAdESEtsiUEntry",
    "JAdESSigTst",
    "JAdESTstVD",
    "JAdESRVals",
    "JAdESXVals",
    "JCSCanonicalizationEnum",
    "JWSProtectedHeaderDecoded",
    "BlockSignature",
    "SignatureBundle",
    "HandwrittenSignature",
    "BiometricCapture",
    "BiometricTypeEnum",
    "JWEKeyManagementAlgEnum",
    "JWEContentEncryptionAlgEnum",
    "JWEProtectedHeaderDecoded",
    "JWEFlattenedJSON"
  ]
}