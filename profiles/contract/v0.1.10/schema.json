{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2-schema.org/profiles/contract/v0.1.10/schema.json",
  "title": "Contract Profile v0.1.10",
  "version": "0.1.10",
  "description": "Body-owning Contract DOMAIN profile (GV-lean, 2026-06-25): OWNS the contract primitives (ContractParty/ContractClause/PartyAddress/PartyContact/PartyIdentifier/PartyRoleEnum/PartyTypeEnum/PartySignatureStateEnum/SignatoryBlock/ClauseTypeEnum/ConsentToESign/USESIGNCompliance/RedlineAction/RedlineActionEnum/SigningCeremonyEvidence/ContractSigningCeremony/HandwrittenContractSignature) — moved OUT of GV in v0.0.13 — plus ContractRoot + ContractConsentReceipt. $refs Grand Vault v0.0.10 for SHARED types and the Signature profile for SignatureNode. Composed (GV v0.0.13 + this profile) reproduces the old GV v0.0.12 def set (lossless).",
  "license": "Apache-2.0",
  "x-a2-role": "profile",
  "x-a2-base-schema": "https://a2-schema.org/vault/v0.0.10/schema.json",
  "x-a2-depends-on": [
    "signature-profile-v0.0.3"
  ],
  "$defs": {
    "ContractClause": {
      "type": "object",
      "description": "A contract clause. Extends GV SemanticBlock with taxonomy, numbering, and legal-basis tagging.",
      "properties": {
        "$tag": {
          "const": "Clause"
        },
        "clauseType": {
          "$ref": "#/$defs/ClauseTypeEnum"
        },
        "clauseNumber": {
          "type": "string",
          "description": "e.g., '3.2', 'Article IV', '第3条'."
        },
        "displayLabel": {
          "type": "string"
        },
        "displayLabelLocale": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Paragraph"
          },
          "description": "The clause body as ordered paragraphs (the 第N条 content). Each renders with a derived \"1 / 2 / 3\" number."
        },
        "appliesTo": {
          "type": "array",
          "items": {
            "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/BaseRef"
          }
        },
        "survivesTermination": {
          "type": "boolean"
        },
        "survivalDuration": {
          "type": "string",
          "description": "ISO 8601 duration."
        },
        "standardClauseRef": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/BaseRef"
        },
        "isCustomized": {
          "type": "boolean"
        },
        "negotiationStatus": {
          "type": "string",
          "enum": [
            "agreed",
            "proposed",
            "counter-proposed",
            "rejected",
            "pending-review",
            "deal-breaker"
          ]
        },
        "jpLegalBasis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JPLegalBasisEnum"
          }
        },
        "usLegalBasis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/USLegalBasisEnum"
          }
        },
        "riskLevel": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "containsObligations": {
          "type": "array",
          "items": {
            "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/BaseRef"
          }
        }
      },
      "required": [
        "clauseType"
      ],
      "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/SemanticBlock"
    },
    "ClauseTypeEnum": {
      "type": "string",
      "description": "Standard taxonomy of contract clause categories.",
      "enum": [
        "recital",
        "definition",
        "scope-of-work",
        "deliverable",
        "acceptance-criteria",
        "payment-terms",
        "consideration",
        "fees",
        "expenses",
        "taxes",
        "term-duration",
        "effective-date",
        "commencement",
        "renewal",
        "termination-for-cause",
        "termination-for-convenience",
        "termination-notice",
        "cure-period",
        "survival",
        "confidentiality",
        "non-disclosure",
        "non-compete",
        "non-solicitation",
        "non-circumvention",
        "intellectual-property",
        "license-grant",
        "ownership",
        "work-for-hire",
        "moral-rights",
        "background-ip",
        "foreground-ip",
        "warranty",
        "representation",
        "covenant",
        "disclaimer",
        "indemnification",
        "limitation-of-liability",
        "exclusion-of-damages",
        "consequential-damages-waiver",
        "insurance",
        "force-majeure",
        "governing-law",
        "jurisdiction",
        "venue",
        "choice-of-forum",
        "dispute-resolution",
        "arbitration",
        "mediation",
        "negotiation-cooling-off",
        "notices",
        "assignment",
        "delegation",
        "subcontracting",
        "amendment",
        "modification",
        "severability",
        "entire-agreement",
        "merger-integration",
        "counterparts",
        "electronic-signatures",
        "data-protection",
        "data-processing",
        "cross-border-data-transfer",
        "compliance",
        "audit-rights",
        "books-and-records",
        "anti-bribery",
        "anti-corruption",
        "export-control",
        "sanctions",
        "tax-allocation",
        "tax-gross-up",
        "currency",
        "interest-late-fees",
        "set-off",
        "escrow",
        "service-level",
        "performance-metrics",
        "kpi",
        "change-management",
        "change-order",
        "personnel",
        "key-personnel",
        "training",
        "support-maintenance",
        "publicity",
        "marketing-rights",
        "third-party-beneficiaries",
        "no-third-party-beneficiaries",
        "waiver",
        "no-waiver",
        "headings-construction",
        "interpretation",
        "language",
        "execution",
        "further-assurances",
        "relationship-of-parties",
        "independent-contractor-status",
        "no-agency",
        "no-partnership",
        "miscellaneous",
        "boilerplate",
        "jp-shitauke-protection",
        "jp-antitrust-compliance",
        "us-state-law-specific",
        "custom",
        "injunctive-relief"
      ]
    },
    "ConsentToESign": {
      "type": "object",
      "description": "Explicit e-signature consent. Required under US ESIGN §101(c), UETA §5; expected under JP 電子署名法.",
      "properties": {
        "consented": {
          "type": "boolean"
        },
        "consentedAt": {
          "type": "string",
          "format": "date-time"
        },
        "consentText": {
          "type": "string"
        },
        "consentTextLocale": {
          "type": "string"
        },
        "withdrawalRights": {
          "type": "string",
          "description": "ESIGN §101(c)(1)(B)."
        },
        "hardwareSoftwareRequirements": {
          "type": "string",
          "description": "ESIGN §101(c)(1)(C)(iii)."
        },
        "demonstratedAbility": {
          "type": "boolean",
          "description": "ESIGN §101(c)(1)(C)(ii)."
        },
        "regulatoryFramework": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "US-ESIGN",
              "US-UETA",
              "US-UCC",
              "JP-Denshi-Shomei-Hou",
              "EU-eIDAS",
              "other"
            ]
          }
        }
      },
      "required": [
        "consented",
        "consentedAt"
      ]
    },
    "JPLegalBasisEnum": {
      "type": "string",
      "description": "Japanese statutory basis classification.",
      "enum": [
        "minpou",
        "shouhou",
        "kaisha-hou",
        "roudou-kijun-hou",
        "roudou-keiyaku-hou",
        "haken-hou",
        "shitauke-hou",
        "dokusen-kinshi-hou",
        "fusei-kyousou-boushi-hou",
        "kojin-jouhou-hogo-hou",
        "denshi-shomei-hou",
        "tokutei-shoutorihiki-hou",
        "shouhisha-keiyaku-hou",
        "kokusai-butsuhin-baibai-hou-cisg"
      ]
    },
    "JurisdictionEnum": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code, optionally with subdivision (e.g., 'US-CA', 'US-NY', 'US-DE', 'JP-13' for Tokyo).",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
    },
    "Notarization": {
      "type": "object",
      "description": "Notarial attestation. Covers traditional and remote online notarization (RON).",
      "properties": {
        "notary": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/ActorObject"
        },
        "notaryCommissionId": {
          "type": "string"
        },
        "notaryJurisdiction": {
          "$ref": "#/$defs/JurisdictionEnum"
        },
        "notaryType": {
          "type": "string",
          "enum": [
            "traditional-in-person",
            "remote-online-ron",
            "apostille",
            "jp-koshou-nin"
          ]
        },
        "notarizedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notarySignature": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/BlockSignature"
        },
        "notarialActType": {
          "type": "string",
          "enum": [
            "acknowledgment",
            "jurat",
            "oath",
            "copy-certification",
            "signature-witness"
          ]
        },
        "sealImage": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/ExternalPayload"
        },
        "ronSessionRecording": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/ExternalPayload"
        },
        "apostilleNumber": {
          "type": "string",
          "description": "Hague Apostille for cross-border use."
        }
      }
    },
    "Paragraph": {
      "type": "object",
      "description": "A numbered paragraph inside a clause (the \"1 / 2 / 3\" level). Its ordinal is derived at render from position in Clause.paragraphs; not stored.",
      "properties": {
        "$tag": {
          "const": "Paragraph"
        },
        "paragraphText": {
          "type": "string",
          "description": "The paragraph prose. May contain {{token}} references to sibling properties (see document_render_model.md P3)."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SubItem"
          },
          "description": "Optional \"(1) (2) (3)\" sub-items."
        }
      },
      "required": [
        "paragraphText"
      ]
    },
    "ContractParty": {
      "type": "object",
      "description": "A party to the contract. Extends GV Entity with contract-specific role and identity.",
      "properties": {
        "$tag": {
          "const": "Party"
        },
        "partyRole": {
          "$ref": "#/$defs/PartyRoleEnum"
        },
        "partyType": {
          "$ref": "#/$defs/PartyTypeEnum"
        },
        "legalName": {
          "type": "string"
        },
        "tradeName": {
          "type": "string"
        },
        "legalNameLocal": {
          "type": "string",
          "description": "Name in local script (e.g., 株式会社○○)."
        },
        "legalNameKana": {
          "type": "string",
          "description": "Furigana reading of the legal name (法人名フリガナ)."
        },
        "jurisdictionOfIncorporation": {
          "$ref": "#/$defs/JurisdictionEnum"
        },
        "corporateNumber": {
          "type": "string",
          "pattern": "^[0-9]{13}$",
          "description": "Japanese corporate number (法人番号, 13 digits). Form-facing flat twin of identifiers[type=jp-corporate-number]."
        },
        "registeredOffice": {
          "$ref": "#/$defs/PartyAddress"
        },
        "branchName": {
          "type": "string",
          "description": "Branch / office executing the contract (支店・営業所名)."
        },
        "noticeAddress": {
          "$ref": "#/$defs/PartyAddress"
        },
        "billingAddress": {
          "$ref": "#/$defs/PartyAddress"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartyIdentifier"
          }
        },
        "primaryContact": {
          "$ref": "#/$defs/PartyContact"
        },
        "legalContact": {
          "$ref": "#/$defs/PartyContact"
        },
        "billingContact": {
          "$ref": "#/$defs/PartyContact"
        },
        "signatoryRef": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/BaseRef"
        },
        "signatoryName": {
          "type": "string",
          "description": "Signatory's name (署名者氏名／代表者氏名)."
        },
        "signatoryNameLocal": {
          "type": "string",
          "description": "Signatory's name in local script (署名者氏名・現地語)."
        },
        "signatoryTitle": {
          "type": "string",
          "description": "Signatory's title (署名者役職名). e.g., 'CEO', '代表取締役'."
        },
        "signatoryEmail": {
          "type": "string",
          "format": "email",
          "description": "Signatory's e-mail — e-signature routing destination (署名者メールアドレス)."
        },
        "signingDepartment": {
          "type": "string",
          "description": "Department executing the contract (契約締結部署名／主管部課)."
        },
        "signingDepartmentLocal": {
          "type": "string",
          "description": "Department name in local script (部署名・現地語)."
        },
        "sealType": {
          "type": "string",
          "enum": [
            "electronic-signature",
            "jitsuin",
            "kakuin",
            "mitomein",
            "ginkoin",
            "sign-only",
            "other"
          ],
          "description": "Seal / signing method declared for this party (押印・電子署名タイプ).",
          "x-a2-enum-descriptions": {
            "electronic-signature": "電子署名",
            "jitsuin": "実印（代表者印・登録印）",
            "kakuin": "角印（社印）",
            "mitomein": "認印",
            "ginkoin": "銀行印",
            "sign-only": "署名のみ（記名押印なし）",
            "other": "その他"
          }
        },
        "capacityAttestation": {
          "type": "string",
          "description": "Statement of authority to bind."
        },
        "sanctionsScreening": {
          "type": "object",
          "properties": {
            "screenedAt": {
              "type": "string",
              "format": "date-time"
            },
            "lists": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "OFAC-SDN",
                  "OFAC-non-SDN",
                  "EU-consolidated",
                  "UN-consolidated",
                  "UK-HMT",
                  "JP-METI",
                  "other"
                ]
              }
            },
            "result": {
              "type": "string",
              "enum": [
                "clear",
                "match",
                "potential-match",
                "not-screened"
              ]
            },
            "evidence": {
              "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/BaseRef"
            }
          }
        }
      },
      "required": [
        "partyRole",
        "legalName"
      ],
      "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/Entity"
    },
    "PartyAddress": {
      "type": "object",
      "description": "Postal address. Used for notices, service of process, and registered office.",
      "properties": {
        "addressLine1": {
          "type": "string"
        },
        "addressLine2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "stateRegion": {
          "type": "string",
          "description": "State (US), Prefecture (JP, e.g., '東京都')."
        },
        "postalCode": {
          "type": "string",
          "description": "ZIP (US) or 郵便番号 (JP)."
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2."
        },
        "attentionTo": {
          "type": "string"
        },
        "jpAddressFormatted": {
          "type": "string",
          "description": "Full address in Japanese format (都道府県市区町村番地建物名)."
        }
      },
      "required": []
    },
    "PartyContact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "department": {
          "type": "string",
          "description": "Contact's department (部署名)."
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "description": "BCP-47 language tag."
        }
      },
      "required": [
        "name"
      ]
    },
    "PartyIdentifier": {
      "type": "object",
      "description": "Government-issued or registry identifier for a party.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "jp-corporate-number",
            "jp-mynumber-individual",
            "jp-shouji-touki-bangou",
            "us-ein",
            "us-ssn-last4",
            "us-state-entity-id",
            "duns",
            "lei",
            "vat-eu",
            "iso-6523",
            "passport",
            "drivers-license",
            "other"
          ]
        },
        "value": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "issuedDate": {
          "type": "string",
          "format": "date"
        },
        "expiresOn": {
          "type": "string",
          "format": "date"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "verifiedBy": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "PartyRoleEnum": {
      "type": "string",
      "description": "Role a party plays in a contract. Domain specialization of GV ActorRoleEnum.",
      "enum": [
        "disclosing",
        "receiving",
        "mutual",
        "buyer",
        "seller",
        "supplier",
        "customer",
        "vendor",
        "licensor",
        "licensee",
        "lessor",
        "lessee",
        "landlord",
        "tenant",
        "employer",
        "employee",
        "contractor",
        "subcontractor",
        "client",
        "service-provider",
        "service-recipient",
        "principal",
        "agent",
        "broker",
        "guarantor",
        "guaranteed-party",
        "surety",
        "assignor",
        "assignee",
        "transferor",
        "transferee",
        "indemnifying-party",
        "indemnified-party",
        "trustor",
        "trustee",
        "beneficiary",
        "borrower",
        "lender",
        "investor",
        "issuer-securities",
        "witness",
        "notary",
        "third-party-beneficiary",
        "obligor",
        "obligee"
      ]
    },
    "PartySignatureStateEnum": {
      "type": "string",
      "enum": [
        "invited",
        "viewed",
        "in-progress",
        "signed",
        "declined",
        "delegated",
        "revoked",
        "expired"
      ]
    },
    "PartyTypeEnum": {
      "type": "string",
      "description": "Legal form of party. Includes Japanese corporate forms (株式会社, 合同会社, 合資会社, 合名会社, 一般社団法人, 公益社団法人) and US forms (C-Corp, S-Corp, LLC, LP, LLP).",
      "enum": [
        "individual",
        "corporation",
        "kabushiki-kaisha",
        "godo-kaisha",
        "goshi-kaisha",
        "llc",
        "lp",
        "llp",
        "c-corp",
        "s-corp",
        "partnership",
        "sole-proprietorship",
        "government-entity",
        "non-profit",
        "ippan-shadan-houjin",
        "koueki-shadan-houjin",
        "trust",
        "estate",
        "joint-venture",
        "branch-office",
        "representative-office",
        "other",
        "university"
      ]
    },
    "RedlineAction": {
      "type": "object",
      "description": "Structured redline change during negotiation.",
      "properties": {
        "$tag": {
          "const": "Redline"
        },
        "redlineId": {
          "type": "string"
        },
        "targetRef": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/BaseRef"
        },
        "action": {
          "$ref": "#/$defs/RedlineActionEnum"
        },
        "originalText": {
          "type": "string"
        },
        "proposedText": {
          "type": "string"
        },
        "proposedBy": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/ActorObject"
        },
        "proposedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "counter-proposed",
            "withdrawn"
          ]
        },
        "respondedBy": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/ActorObject"
        },
        "respondedAt": {
          "type": "string",
          "format": "date-time"
        },
        "respondedRationale": {
          "type": "string"
        }
      },
      "required": [
        "redlineId",
        "targetRef",
        "action"
      ],
      "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/Entity"
    },
    "RedlineActionEnum": {
      "type": "string",
      "enum": [
        "insert",
        "delete",
        "replace",
        "comment-only",
        "accept",
        "reject",
        "propose-alternative"
      ]
    },
    "SignatoryBlock": {
      "type": "object",
      "description": "Complete signature record for one party. Wraps GV BlockSignature with party reference, capacity, and ceremony evidence.",
      "properties": {
        "$tag": {
          "const": "SignatoryBlock"
        },
        "partyRef": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/BaseRef"
        },
        "signatory": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/ActorObject"
        },
        "signatoryTitle": {
          "type": "string",
          "description": "e.g., 'CEO', '代表取締役'."
        },
        "capacityToBind": {
          "type": "string",
          "description": "e.g., 'as duly authorized officer', 'pursuant to board resolution of YYYY-MM-DD'."
        },
        "signature": {
          "$ref": "https://a2-schema.org/vault/v0.0.10/schema.json#/$defs/BlockSignature"
        },
        "signedAt": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "$ref": "#/$defs/PartySignatureStateEnum"
