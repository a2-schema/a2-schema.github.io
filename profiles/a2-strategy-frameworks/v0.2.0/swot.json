        "key": "threat",
        "title": "脅威 (Threat)",
        "description": "外部要因: 競合・規制・環境の逆風",
        "needs": [
          "競合の動き",
          "規制・代替品・環境の逆風"
        ]
      },
      {
        "key": "cross",
        "title": "クロスSWOT戦略",
        "description": "SO/WO/ST/WT の掛け合わせから導く具体戦略"
      }
    ],
    "prompt": "内部要因(S/W)と外部要因(O/T)を峻別する。cross では SO(強み×機会で攻める)/WO(弱みを補って機会を掴む)/ST(強みで脅威を回避)/WT(防衛・撤退)の順に具体的な戦略を出す。"
  }
