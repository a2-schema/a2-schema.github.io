  "framework": {
    "sections": [
      {
        "key": "strength",
        "title": "強み (Strength)",
        "description": "内部要因: 他社に勝る点・実績・資産",
        "needs": [
          "他社に勝る点・実績",
          "独自の資産・技術・チャネル"
        ]
      },
      {
        "key": "weakness",
        "title": "弱み (Weakness)",
        "description": "内部要因: 劣る点・不足している資源",
        "needs": [
          "競合に劣る点",
          "不足している資源・能力"
        ]
      },
      {
        "key": "opportunity",
        "title": "機会 (Opportunity)",
        "description": "外部要因: 市場・環境の追い風",
