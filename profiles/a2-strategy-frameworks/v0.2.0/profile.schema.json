{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2-schema.org/profiles/a2-strategy-frameworks/v0.2.0/profile.schema.json",
  "title": "a2 Strategy-Framework Profile (meta-schema)",
  "description": "Validates every profile file in this set. v0.2.0 (owner ruling 2026-07-24): a profile is either (a) a GENERATIVE framework — `framework` block (sections + prompt) consumed by a2-mind's framework auto-generation (analysis is GENERATED from the map's information; missing info is asked back as ❓ nodes; regeneration improves the analysis) — or (b) a typed-node profile (nodeTypes/template/genTargets) as in v0.1.0. Template-only insertion is deprecated for frameworks (nodes alone add no value — owner ruling). Consumers: a2-mind / a2-plan, READ-ONLY (binding C6: adding a profile requires zero core change). Hard rule unchanged: every fields property stays OPTIONAL (x-a2-complete-when is a UI concern).",
  "type": "object",
  "required": [
    "profile",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*@[1-9][0-9]*$",
      "description": "Profile id '<name>@<major>'. Major bumps only on breaking change."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "framework": {
      "type": "object",
      "required": [
        "sections",
        "prompt"
      ],
      "additionalProperties": false,
      "description": "Generative framework definition. a2-mind generates the analysis from the map's content into <title> → section nodes → generated items, plus ❓ missing-info ask nodes; user answers under ❓ nodes feed regeneration.",
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "key",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "needs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "この観点の分析に必要な情報（不足時は ❓ で問い返す材料）"
              }
            }
          }
        },
        "prompt": {
          "type": "string",
          "description": "フレームワーク固有の分析指針（品質規範）。"
        }
      }
    },
    "nodeTypes": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9][a-zA-Z0-9.-]*$": {
          "$ref": "#/$defs/NodeType"
        }
      },
      "additionalProperties": false
    },
    "template": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/TemplateNode"
      }
    },
    "genTargets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.(docx|html|csv|pdf)$"
      }
    }
  },
  "$defs": {
    "NodeType": {
      "type": "object",
      "required": [
        "title",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "object"
        },
        "x-a2-complete-when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TemplateNode": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemplateNode"
          }
        }
      }
    }
  }
}
