{
  "profile": "product-spec@1",
  "title": "商品開発仕様",
  "description": "商品/機能開発の仕様構成。ユーザーニーズ→要求 (MoSCoW)→仕様（計測可能な目標値）→制約→未解決課題。a2-gen で仕様書 docx に生成する。",
  "nodeTypes": {
    "product.overview": {
      "title": "概要",
      "description": "対象ユーザーと提供価値。",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "targetUser": { "type": "string", "description": "対象ユーザー" },
          "valueProposition": { "type": "string", "description": "提供価値の一行定義" }
        }
      },
      "x-a2-complete-when": ["targetUser", "valueProposition"]
    },
    "product.userNeed": {
      "title": "ユーザーニーズ",
      "description": "根拠付きのニーズ。",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence": { "type": "string", "description": "根拠（ResearchDoc id / URL / インタビュー）" },
          "severity": { "type": "integer", "minimum": 1, "maximum": 5, "description": "深刻度 1〜5" }
        }
      },
      "x-a2-complete-when": ["evidence"]
    },
    "product.requirement": {
      "title": "要求",
      "description": "MoSCoW 優先度と受入条件を持つ要求。",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "priority": { "type": "string", "enum": ["must", "should", "could", "wont"], "description": "MoSCoW 優先度" },
          "acceptance": { "type": "string", "description": "受入条件（検証可能な文）" }
        }
      },
      "x-a2-complete-when": ["priority", "acceptance"]
    },
    "product.spec": {
      "title": "仕様",
      "description": "計測可能な目標値を持つ仕様項目。",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric": { "type": "string", "description": "計測指標" },
          "target": { "type": "string", "description": "目標値" }
        }
      },
      "x-a2-complete-when": ["metric", "target"]
    },
    "product.constraint": {
      "title": "制約",
      "description": "法規・技術・コスト・スケジュール等の制約。",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["legal", "technical", "cost", "schedule", "other"], "description": "制約種別" }
        }
      },
      "x-a2-complete-when": ["kind"]
    },
    "product.openIssue": {
      "title": "未解決課題",
      "description": "決めきれていない論点。担当と期限を付ける。",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner": { "type": "string", "description": "担当" },
          "due": { "type": "string", "format": "date", "description": "解決期限 (YYYY-MM-DD)" }
        }
      },
      "x-a2-complete-when": ["owner"]
    }
  },
  "template": [
    { "text": "概要", "type": "product.overview" },
    { "text": "ユーザーニーズ", "type": "product.userNeed",
      "children": [ { "text": "（ニーズを追加）", "type": "product.userNeed" } ] },
    { "text": "要求 (MoSCoW)", "type": "product.requirement",
      "children": [ { "text": "（要求を追加）", "type": "product.requirement" } ] },
    { "text": "仕様", "type": "product.spec",
      "children": [ { "text": "（仕様を追加）", "type": "product.spec" } ] },
    { "text": "制約", "type": "product.constraint",
      "children": [ { "text": "（制約を追加）", "type": "product.constraint" } ] },
    { "text": "未解決課題", "type": "product.openIssue",
      "children": [ { "text": "（課題を追加）", "type": "product.openIssue" } ] }
  ],
  "genTargets": ["product-spec.docx", "summary.html"]
}
